# Aaroh Marketplace Frontend Environment Variables
# Copy this file to .env before starting the development server

# Application Name
VITE_APP_NAME="Aaroh - Traditional Indian Arts & Crafts"
VITE_APP_ENV=development

# Cloudflare Turnstile CAPTCHA (Frontend Site Key)
# Default test site key from Cloudflare (Always passes for development/testing):
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# API Gateway URL (Leave blank to use relative proxy routing)
VITE_API_BASE_URL=
