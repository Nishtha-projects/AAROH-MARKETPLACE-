# Aaroh Marketplace Backend Environment Variables
# Copy this file to server/.env

# Server Port & Runtime
PORT=5000
NODE_ENV=development

# JWT Secret for Session Tokens
JWT_SECRET=aaroh_secure_jwt_secret_token_key_2026_heritage_artisan

# Demo OTP Mode (Strictly restricted to local development; impossible in production)
# When true, demo accounts can sign in with OTP 123456
OTP_DEMO_MODE=true

# Cloudflare Turnstile CAPTCHA (Server Secret Key)
# Default test secret key from Cloudflare (Always validates in dev):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OAuth Providers (Google & Microsoft)
# Leave blank to use honest setup guide dialogs; configure real credentials for live SSO:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback

# Twilio SMS OTP (Optional)
# If unconfigured, phone OTP operates in local development sandbox mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP Email Configuration
# Option A: Gmail (Requires 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Aaroh Living Crafts" <noreply@aaroh-marketplace.in>

# Option B: Local Development Mail (Console logging of OTP tokens)
ALLOW_ETHEREAL_DEV_MAIL=true
